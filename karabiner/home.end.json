{
	"description": "Home/End를 줄 맨 앞/뒤 이동으로 변경",
	"manipulators": [
		{
			"conditions": [
				{
					"bundle_identifiers": [
						"^com\\.tinyspeck\\.slackmacgap$"
					],
					"type": "frontmost_application_if"
				}
			],
			"description": "command + left_arrow",
			"from": {
				"key_code": "home",
				"modifiers": { "optional": ["shift"] }
			},
			"to": [
				{
					"key_code": "left_arrow",
					"modifiers": ["left_command"]
				}
			],
			"type": "basic"
		},
		{
			"conditions": [
				{
					"bundle_identifiers": [
						"^com\\.tinyspeck\\.slackmacgap$"
					],
					"type": "frontmost_application_if"
				}
			],
			"description": "command + right_arrow",
			"from": {
				"key_code": "end",
				"modifiers": { "optional": ["shift"] }
			},
			"to": [
				{
					"key_code": "right_arrow",
					"modifiers": ["left_command"]
				}
			],
			"type": "basic"
		}
	]
}